# VideoAI — Environment Config

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://videoai:videoai@postgres:5432/videoai
DATABASE_URL_SYNC=postgresql+psycopg2://videoai:videoai@postgres:5432/videoai

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── HuggingFace & Cloud APIs ──────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ── GPU ───────────────────────────────────────────────────────────────────────
GPU_DEVICE=cuda
GPU_COUNT=1
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT=900

# ── Models ────────────────────────────────────────────────────────────────────
ENABLE_WAN=true
ENABLE_COGVIDEO=true
ENABLE_FLUX=true

# Use 1.3B variant if VRAM < 24GB:
# WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-14B-Diffusers
WAN_I2V_MODEL_ID=Wan-AI/Wan2.1-I2V-14B-480P-Diffusers
COGVIDEO_MODEL_ID=THUDM/CogVideoX-5b
FLUX_MODEL_ID=black-forest-labs/FLUX.1-dev

# ── Content Domains ───────────────────────────────────────────────────────────
ENABLE_GENERAL=true
ENABLE_CINEMATIC=true
ENABLE_INFLUENCER=true

# ── Storage ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=./outputs
MODEL_CACHE_DIR=./model_cache

# Optional: Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=videoai
R2_PUBLIC_URL=

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-in-production
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
